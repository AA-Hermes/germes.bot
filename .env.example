PORT=3000
APP_URL=https://germesbot.vercel.app

BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# Production: provision Neon Postgres in Vercel Marketplace.
# Local development may leave DATABASE_URL empty to use file storage.
DATABASE_URL=

INTEGRATION_STORAGE_FILE=.data/integration.json

# Optional. Without OPENAI_API_KEY the application keeps using EchoLLMProvider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=500
